{
  "name": "bertugfahriozer/ci4seopro",
  "description": "Professional SEO/AI indexing + Sitemap (index) + RSS + News/Image/Video sitemaps for CodeIgniter 4",
  "keywords": ["codeigniter4","seo","sitemap","rss","robots.txt","ai","llms","news","image","video","e-commerce","generative engine optimization","geo","llm"],
  "type": "library",
  "license": "MIT",
  "authors": [{"name": "Bertuğ Fahri ÖZER", "email": "bertugfahriozer@gmail.com"}],
  "require": {
    "php": ">=8.1",
    "codeigniter4/framework": "^4.0"
  },
  "require-dev": {
    "phpunit/phpunit": "^10.0"
  },
  "autoload": {
    "psr-4": {"ci4seopro\\": "src/"},
    "files": ["src/Helpers/seo_helper.php"]
  },
  "extra": {
    "codeigniter4": {
      "discover": {
        "psr4": ["ci4seopro"],
        "commands": [
          "ci4seopro\\Commands\\SeoPing"
        ],
        "helpers": ["seo"]
      }
    }
  }
}
